# Default: omit this variable to keep tracker state in server memory.
# Set it to "browser" to use the original localStorage implementation.
NEXT_PUBLIC_CAT_STORAGE=browser

# Required for server storage. The official Redis Cloud integration on Vercel
# supplies this connection URL.
REDIS_URL=

# Supabase's Vercel Marketplace integration supplies this pooled connection URL.
POSTGRES_URL=

# Set this manually in Vercel. It protects the state API with an owner login.
CAT_OWNER_PASSWORD=
